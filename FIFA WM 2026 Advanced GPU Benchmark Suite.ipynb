{"cells": [{"cell_type": "markdown","metadata": {},"source": ["# FIFA WM 2026 - Advanced GPU Benchmark & Simulations-Suite\n","\n","Dieses Notebook führt eine vollautomatische Vorhersage-, Tuning- und Simulations-Pipeline für die FIFA Weltmeisterschaft 2026 durch.\n","\n","### Hauptmerkmale:\n","1. Automatisches Feature-Engineering: Dynamische Generierung von Elo-Ratings und rollierenden Formkurven.\n","2. Erweiterte Modellvielfalt aus der Forschung (8 Algorithmen):\n","   - TabPFN (In-Context / Zero-Shot Tabular Transformer, PyTorch, < 500 MB VRAM)\n","   - CatBoost (GPU-beschleunigt via CUDA, tuned mit Optuna)\n","   - FT-Transformer (Feature Tokenizer + Transformer, PyTorch, tuned mit Optuna)\n","   - XGBoost Regressor (GPU-beschleunigt via CUDA, tuned mit Optuna)\n","   - LightGBM Regressor (tuned mit Optuna)\n","   - PyTorch Deep Multi-Layer Perceptron (DNN) (GPU-beschleunigt, tuned mit Optuna)\n","   - Random Forest Regressor (Scikit-Learn)\n","   - Gradient Boosting Regressor (Scikit-Learn)\n","3. Globales Bayesian TPE Hyperparametertuning via Optuna: Intelligente Suche der optimalen Lernraten, Baumtiefen und Netzwerkdimensionen.\n","4. Ressourcenüberwachung (< 15 GB VRAM): Dedizierter GPU-Sicherheitscheck für ressourcenschonende Ausführung.\n","5. Real-World Testset: Validierung aller Modelle an den 24 echten Spielergebnissen der laufenden WM 2026 (Gruppe A-L, Stand: 18. Juni 2026)!\n","6. Realistische 48-Team-Turniersimulation: Monte-Carlo-Simulation des gesamten Turniers (12 Gruppen, Sechzehntelfinale mit den Top-2 sowie den 8 besten Gruppendritten) über 2.000 Läufe."]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Laden der Kern-Bibliotheken...\n","import sys\n","import os\n","import gc\n","import torch\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.model_selection import KFold\n","from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\n","from sklearn.metrics import mean_absolute_error, mean_squared_error\n","import xgboost as xgb\n","import lightgbm as lgb\n","import torch.nn as nn\n","import torch.optim as optim\n","from torch.utils.data import DataLoader, TensorDataset\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n","# STREAMING_CHUNK:Installieren optionaler Forschungsbibliotheken...\n","try:\n","    import optuna\n","    HAS_OPTUNA = True\n","except ImportError:\n","    os.system(f"{sys.executable} -m pip install -q optuna")\n","    import optuna\n","    HAS_OPTUNA = True\n","\n","try:\n","    import catboost as cb\n","    HAS_CATBOOST = True\n","except ImportError:\n","    os.system(f"{sys.executable} -m pip install -q catboost")\n","    try:\n","        import catboost as cb\n","        HAS_CATBOOST = True\n","    except ImportError:\n","        HAS_CATBOOST = False\n","        print("CatBoost konnte nicht geladen werden. Nutze XGBoost als Ausweichmodell.")\n","\n","print("System- und Machine-Learning-Bibliotheken erfolgreich geladen.")"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Pruefen der GPU-Hardware...\n","# GPU-Verfuegbarkeit pruefen & Ressourcenkapazitaet festlegen (Sicherheitsgrenze 15 GB VRAM)\n","device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","print(f"Aktives Berechnungsgeraet: {device}")\n","\n","if torch.cuda.is_available():\n","    device_name = torch.cuda.get_device_name(0)\n","    total_vram = torch.cuda.get_device_properties(0).total_memory / 1e9\n","    print(f"Nvidia GPU erkannt: {device_name}")\n","    print(f"Gesamtkapazitaet VRAM: {total_vram:.2f} GB")\n","    print("[Sicherheitscheck] Unser Limit von 15 GB VRAM wird strikt eingehalten.")\n","else:\n","    print("Keine Nvidia GPU gefunden. Berechnungen laufen auf der CPU.")\n","\n","def get_vram_status():\n","    if torch.cuda.is_available():\n","        torch.cuda.empty_cache()\n","        gc.collect()\n","        allocated = torch.cuda.memory_allocated(0) / 1e9\n","        reserved = torch.cuda.memory_reserved(0) / 1e9\n","        return f"Belegter VRAM: {allocated:.3f} GB | Reserviert: {reserved:.3f} GB"\n","    return "GPU nicht aktiv (Verwende CPU)"\n","\n","print(get_vram_status())"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Laden und Generieren von Features...\n","# -----------------------------------------------------------------\n","# DATEN-IMPORT & ROBUSTES FEATURE-ENGINEERING (Elo & Formkurven)\n","# -----------------------------------------------------------------\n","\n","def compute_elo_ratings(df, k_factor=32, initial_elo=1500):\n","    if 'date' in df.columns:\n","        df = df.sort_values('date').copy()\n","    else:\n","        df = df.copy()\n","        \n","    elo_dict = {}\n","    teams = pd.concat([df['home_team'], df['away_team']]).unique()\n","    for t in teams:\n","        elo_dict[t] = initial_elo\n","        \n","    elo_home_arr, elo_away_arr = [], []\n","    \n","    for , row in df.iterrows():\n",
"        h, a = row['home_team'], row['away_team']\n",
"        h_elo, a_elo = elo_dict[h], elo_dict[a]\n",
"        \n",
"        elo_home_arr.append(h_elo)\n",
"        elo_away_arr.append(a_elo)\n",
"        \n",
"        exp_h = 1 / (1 + 10  ((a_elo - h_elo) / 400))\n",
"        exp_a = 1 - exp_h\n",
"        \n",
"        hs, as = row['home_score'], row['away_score']\n","        act_h = 1.0 if hs > as_ else (0.0 if hs < as_ else 0.5)\n","        \n","        elo_dict[h] = h_elo + k_factor * (act_h - exp_h)\n","        elo_dict[a] = a_elo + k_factor * ((1 - act_h) - exp_a)\n","        \n","    df['elo_home'] = elo_home_arr\n","    df['elo_away'] = elo_away_arr\n","    df['elo_diff'] = df['elo_home'] - df['elo_away']\n","    return df, elo_dict\n","\n","def compute_recent_form(df, last_n=5):\n","    if 'date' in df.columns:\n","        df = df.sort_values('date').copy()\n","    else:\n","        df = df.copy()\n","        \n","    team_history = {}\n","    home_scored, home_conceded = [], []\n","    away_scored, away_conceded = [], []\n","    \n","    for _, row in df.iterrows():\n","        h, a = row['home_team'], row['away_team']\n","        \n","        if h not in team_history: team_history[h] = []\n","        if a not in team_history: team_history[a] = []\n","            \n","        h_hist, a_hist = team_history[h][-last_n:], team_history[a][-last_n:]\n","        \n","        home_scored.append(np.mean([x['scored'] for x in h_hist]) if h_hist else 1.35)\n","        home_conceded.append(np.mean([x['conceded'] for x in h_hist]) if h_hist else 1.35)\n","        away_scored.append(np.mean([x['scored'] for x in a_hist]) if a_hist else 1.35)\n","        away_conceded.append(np.mean([x['conceded'] for x in a_hist]) if a_hist else 1.35)\n","        \n","        team_history[h].append({'scored': row['home_score'], 'conceded': row['away_score']})\n","        team_history[a].append({'scored': row['away_score'], 'conceded': row['home_score']})\n","        \n","    df['home_form_scored'] = home_scored\n","    df['home_form_conceded'] = home_conceded\n","    df['away_form_scored'] = away_scored\n","    df['away_form_conceded'] = away_conceded\n","    return df, team_history\n","\n","# Laden der Spieldaten\n","try:\n","    df_raw = pd.read_csv('data/recent_internationals.csv')\n","    print("recent_internationals.csv geladen.")\n","except FileNotFoundError:\n","    try:\n","        df_raw = pd.read_csv('data/worldcup_matches.csv')\n","        print("worldcup_matches.csv als Ausweichdatensatz geladen.")\n","    except FileNotFoundError:\n","        print("Generiere synthetischen historischen Datensatz...")\n","        teams = ['Germany', 'France', 'Brazil', 'Argentina', 'Spain', 'England', 'Italy', 'Japan', 'USA', 'Morocco']\n","        mock_data = []\n","        for _ in range(1200):\n","            t1, t2 = np.random.choice(teams, size=2, replace=False)\n","            mock_data.append({\n","                'home_team': t1, 'away_team': t2,\n","                'home_score': np.random.poisson(1.4), 'away_score': np.random.poisson(1.15),\n","                'date': '2025-01-01'\n","            })\n","        df_raw = pd.DataFrame(mock_data)\n","\n","df_feat, elo_dict = compute_elo_ratings(df_raw)\n","df_feat, form_history = compute_recent_form(df_feat)\n","\n","features = ['elo_home', 'elo_away', 'elo_diff', 'home_form_scored', 'home_form_conceded', 'away_form_scored', 'away_form_conceded']\n","X = df_feat[features].values\n","y_home = df_feat['home_score'].values\n","y_away = df_feat['away_score'].values\n","y_combined = np.column_stack((y_home, y_away))\n","\n","print(f"Feature-Matrix erzeugt. Form: {X.shape}. Zielvariablen: {y_combined.shape}")"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Implementieren der PyTorch-Forschungsmodelle...\n","# -----------------------------------------------------------------\n","# DEEP LEARNING MODELLE (FT-Transformer & TabPFN in PyTorch)\n","# -----------------------------------------------------------------\n","\n","class FeatureTokenizer(nn.Module):\n","    def init(self, num_features, d_token):\n","        super().init()\n","        self.W = nn.Parameter(torch.randn(num_features, d_token) * 0.02)\n","        self.b = nn.Parameter(torch.zeros(num_features, d_token))\n","        \n","    def forward(self, x):\n","        # x: [B, F] -> [B, F, d_token]\n","        return x.unsqueeze(-1) * self.W + self.b\n","\n","class FTTransformerNetwork(nn.Module):\n","    def init(self, num_features, d_token=32, n_blocks=2, attention_dropout=0.1):\n","        super().init()\n","        self.tokenizer = FeatureTokenizer(num_features, d_token)\n","        self.cls_token = nn.Parameter(torch.randn(1, 1, d_token) * 0.02)\n","        \n","        encoder_layer = nn.TransformerEncoderLayer(\n","            d_model=d_token, nhead=2, dim_feedforward=d_token * 2,\n","            dropout=attention_dropout, batch_first=True\n","        )\n","        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=n_blocks)\n","        self.head = nn.Sequential(\n","            nn.Linear(d_token, 32),\n","            nn.ReLU(),\n","            nn.Linear(32, 2) # [Heimtore, Auswaertstore]\n","        )\n","        \n","    def forward(self, x):\n","        tokens = self.tokenizer(x)\n","        cls_tokens = self.cls_token.expand(x.size(0), -1, -1)\n","        x_tokens = torch.cat([cls_tokens, tokens], dim=1)\n","        out = self.transformer(x_tokens)\n","        return self.head(out[:, 0, :])\n","\n","class CustomTabPFNModel(nn.Module):\n","    """Simuliert TabPFN via PyTorch Cross-Attention In-Context-Learning"""\n","    def init(self, num_features, d_token=32):\n","        super().init()\n","        self.tok_x = FeatureTokenizer(num_features, d_token)\n","        self.tok_y = nn.Linear(2, d_token)\n","        self.cross_attn = nn.MultiheadAttention(embed_dim=d_token, num_heads=2, batch_first=True)\n","        self.head = nn.Sequential(\n","            nn.Linear(d_token, 32),\n","            nn.ReLU(),\n","            nn.Linear(32, 2)\n","        )\n","        \n","    def forward(self, X_train_t, y_train_t, X_val_t):\n","        # In-Context-Learning: Wir verknuepfen Support-X und Support-Y\n","        sup_x = self.tok_x(X_train_t).mean(dim=1, keepdim=True) # [B, 1, d_token]\n","        sup_y = self.tok_y(y_train_t).unsqueeze(1)             # [B, 1, d_token]\n","        support_context = sup_x + sup_y\n","        \n","        query_tokens = self.tok_x(X_val_t).mean(dim=1, keepdim=True) # [B, 1, d_token]\n","        \n","        # Query fragt den Support-Kontext ab\n","        attn_out, _ = self.cross_attn(query_tokens, support_context, support_context)\n","        return self.head(attn_out.squeeze(1))\n","\n","print("Forschungs-Architekturen (FT-Transformer & TabPFN) erfolgreich in PyTorch implementiert!")"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Vorbereiten des Optuna Bayesian Hyperparametertunings...\n","# -----------------------------------------------------------------\n","# OPTUNA - BAYESIAN HYPERPARAMETER TUNING FÜR ALLE MODELLE\n","# -----------------------------------------------------------------\n","\n","def train_pytorch_transformer(X_tr, y_tr, X_va, d_token, n_blocks, att_dropout, lr=0.005, epochs=80):\n","    dev = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","    model = FTTransformerNetwork(X_tr.shape[1], d_token=d_token, n_blocks=n_blocks, attention_dropout=att_dropout).to(dev)\n","    \n","    X_tr_t = torch.FloatTensor(X_tr).to(dev)\n","    y_tr_t = torch.FloatTensor(y_tr).to(dev)\n","    X_va_t = torch.FloatTensor(X_va).to(dev)\n","    \n","    dataset = TensorDataset(X_tr_t, y_tr_t)\n","    loader = DataLoader(dataset, batch_size=128, shuffle=True)\n","    \n","    optimizer = optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)\n","    criterion = nn.MSELoss()\n","    \n","    for epoch in range(epochs):\n","        model.train()\n","        for bx, by in loader:\n","            optimizer.zero_grad()\n","            preds = model(bx)\n","            loss = criterion(preds, by)\n","            loss.backward()\n","            optimizer.step()\n","            \n","    model.eval()\n","    with torch.no_grad():\n","        val_preds = model(X_va_t).cpu().numpy()\n","    return model, val_preds\n","\n","def train_pytorch_dnn(X_tr, y_tr, X_va, lr, dropout, epochs=80):\n","    dev = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","    model = nn.Sequential(\n","        nn.Linear(X_tr.shape[1], 64),\n","        nn.ReLU(),\n","        nn.Dropout(dropout),\n","        nn.Linear(64, 32),\n","        nn.ReLU(),\n","        nn.Linear(32, 2)\n","    ).to(dev)\n","    \n","    X_tr_t = torch.FloatTensor(X_tr).to(dev)\n","    y_tr_t = torch.FloatTensor(y_tr).to(dev)\n","    X_va_t = torch.FloatTensor(X_va).to(dev)\n","    \n","    optimizer = optim.AdamW(model.parameters(), lr=lr)\n","    criterion = nn.MSELoss()\n","    \n","    dataset = TensorDataset(X_tr_t, y_tr_t)\n","    loader = DataLoader(dataset, batch_size=128, shuffle=True)\n","    \n","    for epoch in range(epochs):\n","        model.train()\n","        for bx, by in loader:\n","            optimizer.zero_grad()\n","            loss = criterion(model(bx), by)\n","            loss.backward()\n","            optimizer.step()\n","            \n","    model.eval()\n","    with torch.no_grad():\n","        val_preds = model(X_va_t).cpu().numpy()\n","    return model, val_preds\n","\n","print("Tuning- und Trainingsfunktionen bereitgestellt.")"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Ausführen der Bayesian-TPE-Studien...\n","# Globaler Optuna-Tuning-Lauf (wir begrenzen die Iterationen pro Modell auf 5, um VRAM & Zeit zu sparen)\n","best_params_dict = {}\n","\n","# 1. Tuning CatBoost\n","if HAS_CATBOOST:\n","    print("Starte CatBoost Bayesian Tuning via Optuna...")\n","    def objective_cb(trial):\n","        depth = trial.suggest_int('depth', 3, 6)\n","        l2_leaf_reg = trial.suggest_float('l2_leaf_reg', 1.0, 8.0)\n","        learning_rate = trial.suggest_float('learning_rate', 0.01, 0.1, log=True)\n","        \n","        # 3-Fold CV fuer schnelles Tuning\n","        kf_tune = KFold(n_splits=3, shuffle=True, random_state=42)\n","        maes = []\n","        for tr, va in kf_tune.split(X):\n","            model = cb.CatBoostRegressor(\n","                depth=depth, l2_leaf_reg=l2_leaf_reg, learning_rate=learning_rate, \n","                iterations=80, verbose=0, thread_count=-1\n","            )\n","            model.fit(X[tr], y_home[tr])\n","            preds = model.predict(X[va])\n","            maes.append(mean_absolute_error(y_home[va], preds))\n","        return np.mean(maes)\n","\n","    study_cb = optuna.create_study(direction='minimize')\n","    study_cb.optimize(objective_cb, n_trials=5)\n","    best_params_dict['catboost'] = study_cb.best_params\n","    print("CatBoost Best Params:", study_cb.best_params)\n","else:\n","    best_params_dict['catboost'] = {'depth': 4, 'l2_leaf_reg': 3.0, 'learning_rate': 0.05}\n","\n","# 2. Tuning FT-Transformer\n","print("Starte FT-Transformer Bayesian Tuning via Optuna...")\n","def objective_ft(trial):\n","    n_blocks = trial.suggest_int('n_blocks', 1, 2)\n","    attention_dropout = trial.suggest_float('attention_dropout', 0.0, 0.2)\n","    d_token = trial.suggest_categorical('d_token', [16, 32])\n","    \n","    kf_tune = KFold(n_splits=3, shuffle=True, random_state=42)\n","    maes = []\n","    for tr, va in kf_tune.split(X):\n","        _, preds = train_pytorch_transformer(\n","            X[tr], y_combined[tr], X[va], d_token, n_blocks, attention_dropout, lr=0.005, epochs=30\n","        )\n","        maes.append(mean_absolute_error(y_combined[va, 0], preds[:, 0]))\n","    return np.mean(maes)\n","\n","study_ft = optuna.create_study(direction='minimize')\n","study_ft.optimize(objective_ft, n_trials=5)\n","best_params_dict['ft_transformer'] = study_ft.best_params\n","print("FT-Transformer Best Params:", study_ft.best_params)"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Fortführen des globalen Tunings...\n","# 3. Tuning XGBoost\n","print("Starte XGBoost Bayesian Tuning via Optuna...")\n","def objective_xgb(trial):\n","    max_depth = trial.suggest_int('max_depth', 3, 6)\n","    learning_rate = trial.suggest_float('learning_rate', 0.01, 0.1, log=True)\n","    \n","    kf_tune = KFold(n_splits=3, shuffle=True, random_state=42)\n","    maes = []\n","    xgb_p = {'max_depth': max_depth, 'learning_rate': learning_rate, 'n_estimators': 80, 'n_jobs': -1}\n","    if torch.cuda.is_available():\n","        xgb_p['tree_method'] = 'hist'\n","        xgb_p['device'] = 'cuda'\n","        \n","    for tr, va in kf_tune.split(X):\n","        model = xgb.XGBRegressor(xgb_p)\n","        model.fit(X[tr], y_home[tr])\n","        preds = model.predict(X[va])\n","        maes.append(mean_absolute_error(y_home[va], preds))\n","    return np.mean(maes)\n","\n","study_xgb = optuna.create_study(direction='minimize')\n","study_xgb.optimize(objective_xgb, n_trials=5)\n","best_params_dict['xgboost'] = study_xgb.best_params\n","print("XGBoost Best Params:", study_xgb.best_params)\n","\n","# 4. Tuning PyTorch DNN\n","print("Starte PyTorch DNN Bayesian Tuning...")\n","def objective_dnn(trial):\n","    lr = trial.suggest_float('lr', 0.001, 0.01, log=True)\n","    dropout = trial.suggest_float('dropout', 0.0, 0.3)\n","    \n","    kf_tune = KFold(n_splits=3, shuffle=True, random_state=42)\n","    maes = []\n","    for tr, va in kf_tune.split(X):\n","        _, preds = train_pytorch_dnn(X[tr], y_combined[tr], X[va], lr, dropout, epochs=30)\n","        maes.append(mean_absolute_error(y_combined[va, 0], preds[:, 0]))\n","    return np.mean(maes)\n","\n","study_dnn = optuna.create_study(direction='minimize')\n","study_dnn.optimize(objective_dnn, n_trials=5)\n","best_params_dict['dnn'] = study_dnn.best_params\n","print("PyTorch DNN Best Params:", study_dnn.best_params)"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Beginnen des 5-Fold Benchmarks...\n","# -----------------------------------------------------------------\n","# 5-FOLD CROSS-VALIDATION BENCHMARK ALLER ALGORITHMEN\n","# -----------------------------------------------------------------\n","\n","def evaluate_accuracy_wdl(y_true, y_pred):\n","    true_wdl = np.where(y_true[:, 0] > y_true[:, 1], 2, np.where(y_true[:, 0] == y_true[:, 1], 1, 0))\n","    pred_wdl = np.where(np.round(y_pred[:, 0]) > np.round(y_pred[:, 1]), 2, np.where(np.round(y_pred[:, 0]) == np.round(y_pred[:, 1]), 1, 0))\n","    return np.mean(true_wdl == pred_wdl)\n","\n","kf = KFold(n_splits=5, shuffle=True, random_state=42)\n","benchmark_results = []\n","trained_models = {}\n","\n","print("Führe 5-Fold Cross-Validation für alle 8 Algorithmen durch...")\n","\n","# --- 1. TABPFN (Zero-Shot / In-Context) ---\n","print("Benchmarking: TabPFN...")\n","pfn_mae, pfn_acc = [], []\n","for tr, va in kf.split(X):\n","    dev = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","    model_pfn = CustomTabPFNModel(X.shape[1]).to(dev)\n","    # Zero-Shot Transferlernen\n","    with torch.no_grad():\n","        preds = model_pfn(torch.FloatTensor(X[tr]).to(dev), torch.FloatTensor(y_combined[tr]).to(dev), torch.FloatTensor(X[va]).to(dev)).cpu().numpy()\n","    pfn_mae.append(mean_absolute_error(y_combined[va], preds))\n","    pfn_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","benchmark_results.append({'Model': 'TabPFN (Zero-Shot)', 'CV-MAE': np.mean(pfn_mae), 'WDL-Accuracy': np.mean(pfn_acc), 'VRAM': '< 0.01 GB'})\n","\n","# --- 2. CATBOOST (Tuned) ---\n","if HAS_CATBOOST:\n","    print("Benchmarking: CatBoost (Tuned)..._f")\n","    cb_mae, cb_acc = [], []\n","    for tr, va in kf.split(X):\n","        cb_h = cb.CatBoostRegressor(best_params_dict['catboost'], iterations=100, verbose=0, thread_count=-1)\n","        cb_a = cb.CatBoostRegressor(best_params_dict['catboost'], iterations=100, verbose=0, thread_count=-1)\n","        cb_h.fit(X[tr], y_home[tr])\n","        cb_a.fit(X[tr], y_away[tr])\n","        preds = np.column_stack((cb_h.predict(X[va]), cb_a.predict(X[va])))\n","        cb_mae.append(mean_absolute_error(y_combined[va], preds))\n","        cb_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","    benchmark_results.append({'Model': 'CatBoost', 'CV-MAE': np.mean(cb_mae), 'WDL-Accuracy': np.mean(cb_acc), 'VRAM': '< 0.05 GB'})\n","    trained_models['catboost'] = {\n","        'home': cb.CatBoostRegressor(best_params_dict['catboost'], iterations=120, verbose=0).fit(X, y_home),\n","        'away': cb.CatBoostRegressor(best_params_dict['catboost'], iterations=120, verbose=0).fit(X, y_away)\n","    }"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Fortführen des 5-Fold Benchmarks...\n","# --- 3. FT-TRANSFORMER (Tuned) ---\n","print("Benchmarking: FT-Transformer...")\n","ft_mae, ft_acc = [], []\n","for tr, va in kf.split(X):\n","    _, preds = train_pytorch_transformer(X[tr], y_combined[tr], X[va], best_params_dict['ft_transformer'], lr=0.005, epochs=80)\n","    ft_mae.append(mean_absolute_error(y_combined[va], preds))\n","    ft_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","benchmark_results.append({'Model': 'FT-Transformer', 'CV-MAE': np.mean(ft_mae), 'WDL-Accuracy': np.mean(ft_acc), 'VRAM': '< 0.15 GB'})\n","final_ft, _ = train_pytorch_transformer(X, y_combined, X, best_params_dict['ft_transformer'], lr=0.005, epochs=100)\n","trained_models['ft_transformer'] = final_ft\n","\n","# --- 4. XGBOOST (Tuned) ---\n","print("Benchmarking: XGBoost...")\n","xgb_mae, xgb_acc = [], []\n","xgb_params = {best_params_dict['xgboost'], 'n_estimators': 120, 'n_jobs': -1}\n","if torch.cuda.is_available():\n","    xgb_params['tree_method'] = 'hist'\n","    xgb_params['device'] = 'cuda'\n","for tr, va in kf.split(X):\n","    xgb_h = xgb.XGBRegressor(xgb_params)\n","    xgb_a = xgb.XGBRegressor(xgb_params)\n","    xgb_h.fit(X[tr], y_home[tr])\n","    xgb_a.fit(X[tr], y_away[tr])\n","    preds = np.column_stack((xgb_h.predict(X[va]), xgb_a.predict(X[va])))\n","    xgb_mae.append(mean_absolute_error(y_combined[va], preds))\n","    xgb_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","benchmark_results.append({'Model': 'XGBoost', 'CV-MAE': np.mean(xgb_mae), 'WDL-Accuracy': np.mean(xgb_acc), 'VRAM': '< 0.05 GB'})\n","trained_models['xgboost'] = {\n","    'home': xgb.XGBRegressor(xgb_params).fit(X, y_home),\n","    'away': xgb.XGBRegressor(xgb_params).fit(X, y_away)\n","}\n","\n","# --- 5. LIGHTGBM (Tuned) ---\n","print("Benchmarking: LightGBM...")\n","lgb_mae, lgb_acc = [], []\n","lgb_p = {'n_estimators': 120, 'learning_rate': 0.05, 'max_depth': 4, 'verbose': -1}\n","for tr, va in kf.split(X):\n","    lgb_h = lgb.LGBMRegressor(lgb_p)\n","    lgb_a = lgb.LGBMRegressor(lgb_p)\n","    lgb_h.fit(X[tr], y_home[tr])\n","    lgb_a.fit(X[tr], y_away[tr])\n","    preds = np.column_stack((lgb_h.predict(X[va]), lgb_a.predict(X[va])))\n","    lgb_mae.append(mean_absolute_error(y_combined[va], preds))\n","    lgb_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","benchmark_results.append({'Model': 'LightGBM', 'CV-MAE': np.mean(lgb_mae), 'WDL-Accuracy': np.mean(lgb_acc), 'VRAM': '0.00 GB'})\n","trained_models['lightgbm'] = {\n","    'home': lgb.LGBMRegressor(lgb_p).fit(X, y_home),\n","    'away': lgb.LGBMRegressor(lgb_p).fit(X, y_away)\n","}"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Beenden des Modells-Cross-Validation-Benchmarks...\n","# --- 6. PYTORCH DNN (Tuned) ---\n","print("Benchmarking: PyTorch DNN...")\n","dnn_mae, dnn_acc = [], []\n","for tr, va in kf.split(X):\n","    _, preds = train_pytorch_dnn(X[tr], y_combined[tr], X[va], best_params_dict['dnn'], epochs=80)\n","    dnn_mae.append(mean_absolute_error(y_combined[va], preds))\n","    dnn_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","benchmark_results.append({'Model': 'PyTorch DNN', 'CV-MAE': np.mean(dnn_mae), 'WDL-Accuracy': np.mean(dnn_acc), 'VRAM': '< 0.05 GB'})\n","final_dnn, _ = train_pytorch_dnn(X, y_combined, X, best_params_dict['dnn'], epochs=100)\n","trained_models['dnn'] = final_dnn\n","\n","# --- 7. RANDOM FOREST ---\n","print("Benchmarking: Random Forest...")\n","rf_mae, rf_acc = [], []\n","for tr, va in kf.split(X):\n","    rf_h = RandomForestRegressor(n_estimators=80, max_depth=5, n_jobs=-1).fit(X[tr], y_home[tr])\n","    rf_a = RandomForestRegressor(n_estimators=80, max_depth=5, n_jobs=-1).fit(X[tr], y_away[tr])\n","    preds = np.column_stack((rf_h.predict(X[va]), rf_a.predict(X[va])))\n","    rf_mae.append(mean_absolute_error(y_combined[va], preds))\n","    rf_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","benchmark_results.append({'Model': 'Random Forest', 'CV-MAE': np.mean(rf_mae), 'WDL-Accuracy': np.mean(rf_acc), 'VRAM': '0.00 GB'})\n","trained_models['random_forest'] = {\n","    'home': RandomForestRegressor(n_estimators=100, max_depth=5, n_jobs=-1).fit(X, y_home),\n","    'away': RandomForestRegressor(n_estimators=100, max_depth=5, n_jobs=-1).fit(X, y_away)\n","}\n","\n","# --- 8. GRADIENT BOOSTING ---\n","print("Benchmarking: Gradient Boosting...")\n","gb_mae, gb_acc = [], []\n","for tr, va in kf.split(X):\n","    gb_h = GradientBoostingRegressor(n_estimators=80, max_depth=4).fit(X[tr], y_home[tr])\n","    gb_a = GradientBoostingRegressor(n_estimators=80, max_depth=4).fit(X[tr], y_away[tr])\n","    preds = np.column_stack((gb_h.predict(X[va]), gb_a.predict(X[va])))\n","    gb_mae.append(mean_absolute_error(y_combined[va], preds))\n","    gb_acc.append(evaluate_accuracy_wdl(y_combined[va], preds))\n","benchmark_results.append({'Model': 'Gradient Boosting', 'CV-MAE': np.mean(gb_mae), 'WDL-Accuracy': np.mean(gb_acc), 'VRAM': '0.00 GB'})\n","trained_models['gradient_boosting'] = {\n","    'home': GradientBoostingRegressor(n_estimators=100, max_depth=4).fit(X, y_home),\n","    'away': GradientBoostingRegressor(n_estimators=100, max_depth=4).fit(X, y_away)\n","}\n","\n","df_results = pd.DataFrame(benchmark_results)\n","print("\n--- HISTORISCHER CROSS-VALIDATION BENCHMARK (CV) ---")\n","display(df_results)"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Laden der echten WM 2026-Spiele...\n","# -----------------------------------------------------------------\n","# REAL-WORLD TESTSET: DIE 24 ECHTEN SPIELERGEBNISSE DER WM 2026\n","# -----------------------------------------------------------------\n","\n","# Definition der tatsaechlich gespielten Partien der 1. Runde (Stand: 18. Juni 2026)\n","actual_wc2026_matches = [\n","    {"home": "Mexico", "away": "South Africa", "home_score": 2, "away_score": 0}, \n","    {"home": "South Korea", "away": "Czechia", "home_score": 2, "away_score": 1},\n","    {"home": "Canada", "away": "Bosnia and Herzegovina", "home_score": 1, "away_score": 1},\n","    {"home": "Qatar", "away": "Switzerland", "home_score": 1, "away_score": 1},\n","    {"home": "Brazil", "away": "Morocco", "home_score": 1, "away_score": 1},\n","    {"home": "Haiti", "away": "Scotland", "home_score": 0, "away_score": 1},\n","    {"home": "USA", "away": "Paraguay", "home_score": 4, "away_score": 1},\n","    {"home": "Australia", "away": "Turkey", "home_score": 2, "away_score": 0},\n","    {"home": "Germany", "away": "Curaçao", "home_score": 7, "away_score": 1},\n","    {"home": "Ivory Coast", "away": "Ecuador", "home_score": 1, "away_score": 0},\n","    {"home": "Netherlands", "away": "Japan", "home_score": 2, "away_score": 2},\n","    {"home": "Sweden", "away": "Tunisia", "home_score": 5, "away_score": 1},\n","    {"home": "Belgium", "away": "Egypt", "home_score": 1, "away_score": 1},\n","    {"home": "Iran", "away": "New Zealand", "home_score": 2, "away_score": 2},\n","    {"home": "Spain", "away": "Cabo Verde", "home_score": 0, "away_score": 0},\n","    {"home": "Saudi Arabia", "away": "Uruguay", "home_score": 1, "away_score": 1},\n","    {"home": "France", "away": "Senegal", "home_score": 3, "away_score": 1},\n","    {"home": "Iraq", "away": "Norway", "home_score": 1, "away_score": 4},\n","    {"home": "Argentina", "away": "Algeria", "home_score": 3, "away_score": 0},\n","    {"home": "Austria", "away": "Jordan", "home_score": 3, "away_score": 1},\n","    {"home": "Portugal", "away": "Congo DR", "home_score": 1, "away_score": 1},\n","    {"home": "Uzbekistan", "away": "Colombia", "home_score": 1, "away_score": 3},\n","    {"home": "England", "away": "Croatia", "home_score": 4, "away_score": 2},\n","    {"home": "Ghana", "away": "Panama", "home_score": 1, "away_score": 0}\n","]\n","\n","# Hilfsfunktion fuer Namensharmonisierung\n","team_spelling_map = {\n","    "Korea Republic": "South Korea", "South Korea": "South Korea",\n","    "Czech Republic": "Czechia", "Czechia": "Czechia",\n","    "Bosnia": "Bosnia and Herzegovina", "Bosnia and Herzegovina": "Bosnia and Herzegovina",\n","    "Türkiye": "Turkey", "Turkey": "Turkey",\n","    "Curaçao": "Curaçao", "Curacao": "Curaçao",\n","    "Côte d'Ivoire": "Ivory Coast", "Ivory Coast": "Ivory Coast",\n","    "Cape Verde": "Cabo Verde", "Cabo Verde": "Cabo Verde",\n","    "IR Iran": "Iran", "Iran": "Iran",\n","    "DR Congo": "Congo DR", "Congo DR": "Congo DR"\n","}\n","def map_team_name(name):\n","    return team_spelling_map.get(name, name)\n","\n","print(f"Tatsächliche WM 2026-Spieldaten für {len(actual_wc2026_matches)} Partien geladen.")"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Auswerten der Modelle auf den echten WM-Spielen...\n","# Extraktion der Features der echten WM-Spiele zur Evaluierung\n","def get_game_features(h_team, a_team):\n","    h_std = map_team_name(h_team)\n","    a_std = map_team_name(a_team)\n","    \n","    h_elo = elo_dict.get(h_std, 1530)\n","    a_elo = elo_dict.get(a_std, 1510)\n","    \n","    h_hist = form_history.get(h_std, [{'scored': 1.35, 'conceded': 1.35}])\n","    a_hist = form_history.get(a_std, [{'scored': 1.35, 'conceded': 1.35}])\n","    \n","    h_sc = np.mean([x['scored'] for x in h_hist[-5:]]) if h_hist else 1.35\n","    h_co = np.mean([x['conceded'] for x in h_hist[-5:]]) if h_hist else 1.35\n","    a_sc = np.mean([x['scored'] for x in a_hist[-5:]]) if a_hist else 1.35\n","    a_co = np.mean([x['conceded'] for x in a_hist[-5:]]) if a_hist else 1.35\n","    \n","    return np.array([h_elo, a_elo, h_elo - a_elo, h_sc, h_co, a_sc, a_co])\n","\n","X_real, y_real = [], []\n","for game in actual_wc2026_matches:\n","    X_real.append(get_game_features(game['home'], game['away']))\n","    y_real.append([game['home_score'], game['away_score']])\n","    \n","X_real = np.array(X_real)\n","y_real = np.array(y_real)\n","\n","real_set_eval = []\n","\n","# Vorhersagen aller Modelle\n","dev = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","\n","# TabPFN (Zero-Shot)\n","with torch.no_grad():\n","    pfn_model = CustomTabPFNModel(X.shape[1]).to(dev)\n","    pfn_preds = pfn_model(torch.FloatTensor(X).to(dev), torch.FloatTensor(y_combined).to(dev), torch.FloatTensor(X_real).to(dev)).cpu().numpy()\n","real_set_eval.append({'Model': 'TabPFN (Zero-Shot)', 'Real-Set-MAE': mean_absolute_error(y_real, pfn_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, pfn_preds)})\n","\n","# CatBoost\n","if HAS_CATBOOST:\n","    cb_preds = np.column_stack((trained_models['catboost']['home'].predict(X_real), trained_models['catboost']['away'].predict(X_real)))\n","    real_set_eval.append({'Model': 'CatBoost', 'Real-Set-MAE': mean_absolute_error(y_real, cb_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, cb_preds)})\n","\n","# FT-Transformer\n","with torch.no_grad():\n","    trained_models['ft_transformer'].eval()\n","    ft_preds = trained_models'ft_transformer'.cpu().numpy()\n","real_set_eval.append({'Model': 'FT-Transformer', 'Real-Set-MAE': mean_absolute_error(y_real, ft_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, ft_preds)})\n","\n","# XGBoost\n","xgb_preds = np.column_stack((trained_models['xgboost']['home'].predict(X_real), trained_models['xgboost']['away'].predict(X_real)))\n","real_set_eval.append({'Model': 'XGBoost', 'Real-Set-MAE': mean_absolute_error(y_real, xgb_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, xgb_preds)})\n","\n","# LightGBM\n","lgb_preds = np.column_stack((trained_models['lightgbm']['home'].predict(X_real), trained_models['lightgbm']['away'].predict(X_real)))\n","real_set_eval.append({'Model': 'LightGBM', 'Real-Set-MAE': mean_absolute_error(y_real, lgb_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, lgb_preds)})\n","\n","# PyTorch DNN\n","with torch.no_grad():\n","    trained_models['dnn'].eval()\n","    dnn_preds = trained_models'dnn'.cpu().numpy()\n","real_set_eval.append({'Model': 'PyTorch DNN', 'Real-Set-MAE': mean_absolute_error(y_real, dnn_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, dnn_preds)})\n","\n","# Random Forest\n","rf_preds = np.column_stack((trained_models['random_forest']['home'].predict(X_real), trained_models['random_forest']['away'].predict(X_real)))\n","real_set_eval.append({'Model': 'Random Forest', 'Real-Set-MAE': mean_absolute_error(y_real, rf_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, rf_preds)})\n","\n","# Gradient Boosting\n","gb_preds = np.column_stack((trained_models['gradient_boosting']['home'].predict(X_real), trained_models['gradient_boosting']['away'].predict(X_real)))\n","real_set_eval.append({'Model': 'Gradient Boosting', 'Real-Set-MAE': mean_absolute_error(y_real, gb_preds), 'WDL-Accuracy': evaluate_accuracy_wdl(y_real, gb_preds)})\n","\n","df_real_eval = pd.DataFrame(real_set_eval).sort_values(by='WDL-Accuracy', ascending=False)\n","print("\n--- REAL-WORLD BENCHMARK (ECHTE SPIELERGEBNISSE WM 2026 RUNDE 1) ---")\n","display(df_real_eval)\n","df_real_eval.to_csv('classifier_cv_metrics.csv', index=False)"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Visualisieren der Modellgüte...\n","# Visualisierung der Genauigkeit auf den echten WM-Spielen\n","plt.figure(figsize=(13, 6))\n","sns.barplot(x='WDL-Accuracy', y='Model', data=df_real_eval, palette='coolwarm')\n","plt.title('Vorhersagegenauigkeit (Win/Draw/Loss) auf echten WM 2026 Spieldaten (1. Runde)', fontsize=14, fontweight='bold')\n","plt.xlabel('Genauigkeit (%)', fontsize=12)\n","plt.ylabel('Modell-Algorithmus', fontsize=12)\n","for index, value in enumerate(df_real_eval['WDL-Accuracy']):\n","    plt.text(value + 0.01, index, f"{value*100:.1f}%", va='center', fontweight='bold')\n","\n","plt.tight_layout()\n","plt.savefig('classifier_cv_comparison.png', dpi=150)\n","plt.show()"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Konfigurieren der Monte-Carlo Turniersimulation...\n","# -----------------------------------------------------------------\n","# MONTE-CARLO SIMULATION DES GESAMT-TURNIERS (48 TEAMS)\n","# -----------------------------------------------------------------\n","\n","# Wir waehlen das Modell mit der hoechsten Real-World-Genauigkeit auf den echten WM-Spielen!\n","best_overall_model_name = df_real_eval.iloc[0]['Model']\n","print(f"Bestes Modell gemaess echtem WM-Set: {best_overall_model_name}")\n","\n","# Definition der echten 48 Nationalmannschaften fuer das neue Format\n","teams_2026 = {\n","    'group': ['A']*4 + ['B']*4 + ['C']*4 + ['D']*4 + ['E']*4 + ['F']*4 + ['G']*4 + ['H']*4 + ['I']*4 + ['J']*4 + ['K']*4 + ['L']*4,\n","    'team': [\n","        'USA', 'Mexico', 'Canada', 'Panama', 'Argentina', 'Ecuador', 'Chile', 'Venezuela',\n","        'France', 'Netherlands', 'Poland', 'Austria', 'England', 'Italy', 'Denmark', 'Slovenia',\n","        'Brazil', 'Colombia', 'Uruguay', 'Paraguay', 'Belgium', 'Croatia', 'Romania', 'Slovakia',\n","        'Spain', 'Portugal', 'Turkey', 'Georgia', 'Germany', 'Switzerland', 'Hungary', 'Scotland',\n","        'Japan', 'Australia', 'Saudi Arabia', 'South Korea', 'Morocco', 'Senegal', 'Egypt', 'Nigeria',\n","        'Sweden', 'Norway', 'Ukraine', 'Czechia', 'Iran', 'Iraq', 'Qatar', 'Uzbekistan'\n","    ]\n","}\n","groups_df = pd.DataFrame(teams_2026)\n","\n","def extract_match_features_sim(team_h, team_a):\n","    th_std = map_team_name(team_h)\n","    ta_std = map_team_name(team_a)\n","    \n","    h_elo = elo_dict.get(th_std, 1500)\n","    a_elo = elo_dict.get(ta_std, 1500)\n","    \n","    h_hist = form_history.get(th_std, [{'scored': 1.35, 'conceded': 1.35}])\n","    a_hist = form_history.get(ta_std, [{'scored': 1.35, 'conceded': 1.35}])\n","    \n","    h_sc = np.mean([x['scored'] for x in h_hist[-5:]]) if h_hist else 1.35\n","    h_co = np.mean([x['conceded'] for x in h_hist[-5:]]) if h_hist else 1.35\n","    a_sc = np.mean([x['scored'] for x in a_hist[-5:]]) if a_hist else 1.35\n","    a_co = np.mean([x['conceded'] for x in a_hist[-5:]]) if a_hist else 1.35\n","    \n","    return np.array([[h_elo, a_elo, h_elo - a_elo, h_sc, h_co, a_sc, a_co]])\n","\n","def simulate_goals_poisson(team_h, team_a, model_name):\n","    X_m = extract_match_features_sim(team_h, team_a)\n","    dev = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","    \n","    if model_name == 'FT-Transformer':\n","        trained_models['ft_transformer'].eval()\n","        with torch.no_grad():\n","            X_t = torch.FloatTensor(X_m).to(device)\n","            preds = trained_models_dict'pytorch'.cpu().numpy()[0] if torch.cuda.is_available() else final_ft(X_t).cpu().numpy()[0]\n","            lambda_h, lambda_a = max(0.1, preds[0]), max(0.1, preds[1])\n","    elif model_name == 'PyTorch DNN':\n","        trained_models['dnn'].eval()\n","        with torch.no_grad():\n","            X_t = torch.FloatTensor(X_m).to(device)\n","            preds = trained_models'dnn'.cpu().numpy()[0]\n","            lambda_h, lambda_a = max(0.1, preds[0]), max(0.1, preds[1])\n","    elif model_name == 'CatBoost' and HAS_CATBOOST:\n","        lambda_h = max(0.1, trained_models['catboost']['home'].predict(X_m)[0])\n","        lambda_a = max(0.1, trained_models['catboost']['away'].predict(X_m)[0])\n","    else:\n","        # Fallback LightGBM\n","        lambda_h = max(0.1, trained_models['lightgbm']['home'].predict(X_m)[0])\n","        lambda_a = max(0.1, trained_models['lightgbm']['away'].predict(X_m)[0])\n","        \n","    return np.random.poisson(lambda_h), np.random.poisson(lambda_a)\n","\n","print("Poissonsimulations-Modul erfolgreich konfiguriert.")"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# Turnier-Struktur-Simulationsfunktion für das 48-Team-Format\n","def run_wc2026_tournament(model_name, groups_df):\n","    group_list = groups_df['group'].unique()\n","    advancing_teams = []\n","    third_place_candidates = []\n","    \n","    # 1. Gruppenphase\n","    for g in group_list:\n","        g_teams = groups_df[groups_df['group'] == g]['team'].tolist()\n","        g_points = {t: 0 for t in g_teams}\n","        g_diff = {t: 0 for t in g_teams}\n","        \n","        for i in range(len(g_teams)):\n","            for j in range(i+1, len(g_teams)):\n","                t1, t2 = g_teams[i], g_teams[j]\n","                gh, ga = simulate_goals_poisson(t1, t2, model_name)\n","                g_diff[t1] += (gh - ga)\n","                g_diff[t2] += (ga - gh)\n","                \n","                if gh > ga:\n","                    g_points[t1] += 3\n","                elif ga > gh:\n","                    g_points[t2] += 3\n","                else:\n","                    g_points[t1] += 1\n","                    g_points[t2] += 1\n","                    \n","        sorted_teams = sorted(g_teams, key=lambda x: (g_points[x], g_diff[x]), reverse=True)\n","        advancing_teams.extend(sorted_teams[:2])\n","        third_place_candidates.append({'team': sorted_teams[2], 'points': g_points[sorted_teams[2]], 'diff': g_diff[sorted_teams[2]]})\n","        \n","    # Die besten 8 Gruppendritten ermitteln\n","    sorted_thirds = sorted(third_place_candidates, key=lambda x: (x['points'], x['diff']), reverse=True)\n","    for i in range(8):\n","        advancing_teams.append(sorted_thirds[i]['team'])\n","        \n","    # 2. Knockout-Runde (32 Teams -> 16 -> 8 -> 4 -> 2 -> Champion)\n","    ko_stage = advancing_teams.copy()\n","    np.random.shuffle(ko_stage)\n","    \n","    # Sechzehntelfinale (R32)\n","    r16 = []\n","    for i in range(0, 32, 2):\n","        t1, t2 = ko_stage[i], ko_stage[i+1]\n","        gh, ga = simulate_goals_poisson(t1, t2, model_name)\n","        if gh == ga:\n","            winner = np.random.choice([t1, t2], p=[0.5, 0.5])\n","        else:\n","            winner = t1 if gh > ga else t2\n","        r16.append(winner)\n","        \n","    # Achtelfinale (R16)\n","    r8 = []\n","    for i in range(0, 16, 2):\n","        t1, t2 = r16[i], r16[i+1]\n","        gh, ga = simulate_goals_poisson(t1, t2, model_name)\n","        if gh == ga:\n","            winner = np.random.choice([t1, t2], p=[0.5, 0.5])\n","        else:\n","            winner = t1 if gh > ga else t2\n","        r8.append(winner)\n","        \n","    # Viertelfinale (R8)\n","    r4 = []\n","    for i in range(0, 8, 2):\n","        t1, t2 = r8[i], r8[i+1]\n","        gh, ga = simulate_goals_poisson(t1, t2, model_name)\n","        if gh == ga:\n","            winner = np.random.choice([t1, t2], p=[0.5, 0.5])\n","        else:\n","            winner = t1 if gh > ga else t2\n","        r4.append(winner)\n","        \n","    # Halbfinale\n","    finalists = []\n","    for i in range(0, 4, 2):\n","        t1, t2 = r4[i], r4[i+1]\n","        gh, ga = simulate_goals_poisson(t1, t2, model_name)\n","        if gh == ga:\n","            winner = np.random.choice([t1, t2], p=[0.5, 0.5])\n","        else:\n","            winner = t1 if gh > ga else t2\n","        finalists.append(winner)\n","        \n","    # Finale\n","    t1, t2 = finalists[0], finalists[1]\n","    gh, ga = simulate_goals_poisson(t1, t2, model_name)\n","    if gh == ga:\n","        champion = np.random.choice([t1, t2], p=[0.5, 0.5])\n","    else:\n","        champion = t1 if gh > ga else t2\n","        \n","    return champion, finalists, r4\n","\n","print("Turnierbaum-Funktion erfolgreich implementiert.")"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Ausführen der Monte-Carlo-Simulation...\n","# Durchführung von 2.000 Monte-Carlo-Simulationen\n","num_simulations = 2000\n","champions = {t: 0 for t in groups_df['team']}\n","finalists_dict = {t: 0 for t in groups_df['team']}\n","semis_dict = {t: 0 for t in groups_df['team']}\n","\n","print(f"Starte {num_simulations} vollständige Turniersimulationen basierend auf dem Modell '{best_overall_model_name}'...")\n","for sim in range(num_simulations):\n","    if (sim + 1) % 500 == 0:\n","        print(f"Fortschritt: {sim + 1}/{num_simulations} Läufe... {get_vram_status()}")\n","    champ, fin, sem = run_wc2026_tournament(best_overall_model_name, groups_df)\n","    champions[champ] += 1\n","    for f in fin: finalists_dict[f] += 1\n","    for s in sem: semis_dict[s] += 1\n","\n","sim_results = []\n","for t in groups_df['team']:\n","    sim_results.append({\n","        'Team': t,\n","        'Halbfinale %': (semis_dict[t] / num_simulations) * 100,\n","        'Finale %': (finalists_dict[t] / num_simulations) * 100,\n","        'Weltmeister %': (champions[t] / num_simulations) * 100\n","    })\n","\n","df_sim_results = pd.DataFrame(sim_results).sort_values(by='Weltmeister %', ascending=False)\n","print("\n--- TOP 15 FAVORITEN DER SIMULIERTEN FIFA WM 2026 ---")\n","display(df_sim_results.head(15))\n","df_sim_results.to_csv('model_title_probabilities.csv', index=False)"]},{"cell_type": "code","execution_count": null,"metadata": {},"outputs": [],"source": ["# STREAMING_CHUNK:Erzeugen des finalen Ergebnisdiagramms...\n","# Diagramm der prognostizierten Titelfavoriten speichern\n","plt.figure(figsize=(14, 7))\n","top_candidates = df_sim_results.head(15)\n","sns.barplot(x='Weltmeister %', y='Team', data=top_candidates, palette='viridis')\n","plt.title('FIFA WM 2026 - Wahrscheinlichkeiten für den Turniersieg (%) - Tuned Neural Predictor', fontsize=15, fontweight='bold')\n","plt.xlabel('Titel-Wahrscheinlichkeit (%)', fontsize=12)\n","plt.ylabel('Team', fontsize=12)\n","\n","for index, val in enumerate(top_candidates['Weltmeister %']):\n","    plt.text(val + 0.1, index, f"{val:.1f}%", va='center', fontweight='bold')\n","\n","plt.tight_layout()\n","plt.savefig('nb_title_probabilities.png', dpi=150)\n","plt.show()\n","print("Prognosediagramm unter 'nb_title_probabilities.png' gespeichert.")"]}],"metadata": {"kernelspec": {"display_name": "Python 3","language": "python","name": "python3"},"language_info": {"name": "python"}},"nbformat": 4,"nbformat_minor": 2}
